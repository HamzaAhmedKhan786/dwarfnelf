{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MAMA Event",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "type",
    "timestamp"
  ]
}
